# Copy to .env (git-ignored) and fill in.

# --- Frontend (public; safe to ship) -----------------------------------------
# The publishable key grants no data access on its own — Row-Level Security
# decides what each caller can read. Safe in the browser bundle.
VITE_SUPABASE_URL="https://vsxbedlsnfmsbnlfayae.supabase.co"
VITE_SUPABASE_KEY=""

# --- Server-side only (NEVER commit, NEVER ship to the browser) --------------
# The service-role key bypasses Row-Level Security entirely. It belongs in Edge
# Function secrets or your local shell — never in a VITE_* var, which Vite
# inlines into the client bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# Platform vision key, used for subscription users. BYOK users' keys are stored
# per-user as Supabase Vault secrets and resolved inside the Edge Function —
# they never appear here and never reach the browser.
GEMINI_API_KEY=""
